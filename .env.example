# ==========================================
# Website-Grounded RAG Agent Configuration
# ==========================================

# OpenAI API Key (Required for OpenAI LLM generation; if left empty, local extractive mode is used)
OPENAI_API_KEY=your_openai_api_key_here

# LLM Configuration
LLM_PROVIDER=openai               # "openai" or "local_extractive"
OPENAI_MODEL=gpt-4o-mini          # "gpt-4o-mini" or "gpt-4o"
LLM_TEMPERATURE=0.0

# Embedding Configuration
EMBEDDING_PROVIDER=fastembed      # "fastembed" (local ONNX, $0 cost) or "openai"
FASTEMBED_MODEL=BAAI/bge-small-en-v1.5
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Crawler Configuration
SEED_URL=https://fastapi.tiangolo.com/tutorial/
ALLOWED_DOMAIN=fastapi.tiangolo.com
URL_PATH_PREFIX=/tutorial/
MAX_PAGES=25
CRAWL_DELAY_SECONDS=0.2

# Chunking Configuration
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
TOP_K=4
SIMILARITY_SCORE_THRESHOLD=0.30
